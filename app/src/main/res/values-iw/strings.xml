    <string name="sms_title">כל הקבלות נשמרות אוטומטית</string>
    <string name="sms_intro">חנויות שולחות קבלות כקישורים בהודעות SMS, והקישורים מפסיקים לעבוד אחרי זמן מה. כדי לשמור אותן להחזרות ולאחריות, My Receipts צריכה לקרוא את הודעות ה-SMS שלך.</string>
    <string name="sms_reads_title">מה היא קוראת</string>
    <string name="sms_reads_body">הודעות חדשות כשהן מגיעות, ופעם אחת גם את ההודעות שכבר בטלפון, כדי למצוא קישורים לקבלות מחנויות.</string>
    <string name="sms_keeps_title">מה היא שומרת</string>
    <string name="sms_keeps_body">רק את הקישור לקבלה, את שם החנות ואת השעה, ומהקבלה עצמה את קובץ ה-PDF ואת הסכום ששולם. ההודעה עצמה לעולם לא נשמרת.</string>
    <string name="sms_ignores_title">מה היא מדלגת עליו</string>
    <string name="sms_ignores_body">כל הודעה אחרת: קודים, הודעות מהבנק, הודעות אישיות. מדלגים עליהן בטלפון והן לא נשלחות לשום מקום.</string>
    <string name="sms_sends_title">מה היא שולחת</string>
    <string name="sms_sends_body">את הקישור לקבלה, לשרת שלנו, כדי להביא את הקבלה כ-PDF ולקרוא ממנה את הסכום ששולם. שום דבר אחר מההודעות שלך. אם משהו משתבש, דיווח תקלה קצר בלי קישור או הודעה, שאפשר לכבות בהגדרות.</string>
    <string name="sms_never_sends_title">היא לעולם לא שולחת הודעות</string>
    <string name="sms_never_sends_body">בבקשה הבאה של Android כתוב \"לשלוח ולהציג\", כי כך Android מקבצת את ההרשאה הזו. My Receipts רק קוראת.</string>
