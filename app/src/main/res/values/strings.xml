    <!-- SMS disclosure: must stay true of the code, and match the Play SMS declaration -->
    <string name="sms_title">Keep every receipt automatically</string>
    <string name="sms_intro">Shops send receipts as links in text messages, and the links stop working after a while. To save them for returns and warranties, My Receipts needs to read your text messages.</string>
    <string name="sms_reads_title">What it reads</string>
    <string name="sms_reads_body">New texts as they arrive, and once, the texts already on your phone, to find receipt links from shops.</string>
    <string name="sms_keeps_title">What it keeps</string>
    <string name="sms_keeps_body">Only the receipt link, the shop\'s name and the time, and from the receipt itself its PDF and the amount paid. The message itself is never saved.</string>
    <string name="sms_ignores_title">What it ignores</string>
    <string name="sms_ignores_body">Every other message: codes, banks, personal texts. They are skipped on your phone and never sent anywhere.</string>
    <string name="sms_sends_title">What it sends</string>
    <string name="sms_sends_body">The receipt link, to our server, to fetch the receipt as a PDF and read the amount paid from it. Nothing else from your messages.</string>
    <string name="sms_never_sends_title">It never sends texts</string>
    <string name="sms_never_sends_body">Android\'s next prompt says \"send and view\" because that is how it groups this permission. My Receipts only reads.</string>
    <string name="sms_continue">Continue</string>
    <string name="sms_not_now">Not now</string>
